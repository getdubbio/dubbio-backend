{
  "name": "dubbio-backend",
  "version": "0.0.1",
  "description": "Dubbio backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"drizzle.config.ts\" \"*.md\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ drizzle.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "bullmq": "^6.7.6",
    "drizzle-orm": "1.0.0-rc.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vitest": "^5.1.1"
  }
}
